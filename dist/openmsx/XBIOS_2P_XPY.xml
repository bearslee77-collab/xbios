<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>

  <info>
    <manufacturer>XBIOS</manufacturer>
    <code>MSX2P</code>
    <release_year>2026</release_year>
    <description>XBIOS MSX2+ + XPY</description>
    <type>MSX2+</type>
  </info>

  <CassettePort/>

  <devices>

    <primary slot="0">
      <ROM id="XBIOS2 Main ROM">
        <mem base="0x0000" size="0x8000"/>
        <rom>
          <filename>xbios_2p.rom</filename>
        </rom>
      </ROM>
    </primary>

    <primary external="true" slot="1"/>
    <primary external="true" slot="2"/>

    <primary slot="3">
      <secondary slot="0">
        <ROM id="XBIOS2 SUB-ROM">
          <mem base="0x0000" size="0x4000"/>
          <rom>
            <filename>xbios_2p_sub.rom</filename>
          </rom>
        </ROM>
      </secondary>
      <secondary slot="1">
        <ROM id="XPY ROM">
          <mem base="0x4000" size="0x8000"/>
          <rom>
            <filename>xpybank.rom</filename>
          </rom>
          <mappertype>ASCII16</mappertype>
        </ROM>
      </secondary>
      <secondary slot="2">
        <MemoryMapper id="Main RAM">
          <size>128</size>
          <mem base="0x0000" size="0x10000"/>
        </MemoryMapper>
      </secondary>
      <secondary slot="3"/>
    </primary>

    <PPI id="ppi">
      <io base="0xA8" num="4"/>
      <sound><volume>16000</volume></sound>
      <key_ghosting>false</key_ghosting>
      <keyboard_type>int</keyboard_type>
      <has_keypad>false</has_keypad>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP">
      <io base="0x98" num="4" type="O"/>
      <io base="0x98" num="2" type="I"/>
      <version>V9958</version>
      <vram>128</vram>
    </VDP>

    <PSG id="PSG">
      <type>YM2149</type>
      <io base="0xA0" num="4" type="IO"/>
      <sound><volume>21000</volume></sound>
    </PSG>

    <RTC id="Real time clock">
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
      <sramname>xbios_2p.cmos</sramname>
    </RTC>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

    <ResetStatusRegister id="Reset Status register">
      <inverted>true</inverted>
      <io base="0xF4" num="1"/>
    </ResetStatusRegister>

  </devices>

</msxconfig>
