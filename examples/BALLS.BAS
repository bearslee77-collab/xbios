1 ' BALLS.BAS
20 SCREEN 5,3:DEFINT A-Z:N=32:FR=120
30 P$=CHR$(60)+CHR$(126)+CHR$(255)+CHR$(255)+CHR$(255)+CHR$(255)+CHR$(126)+CHR$(60)
40 SPRITE$(0)=P$
50 FOR I=0 TO N-1:PUT SPRITE I,(0,0),I MOD 15+1,0:NEXT I
55 CS#=0
60 T0!=PEEK(&HFC9E)+256!*PEEK(&HFC9F)
70 FOR F=0 TO FR-1
72 A=F AND 511:B=(F+F) AND 511:D=F AND 255:E=(F+F) AND 255
74 O=0:W=0
80 FOR I=0 TO N-1
90 IF I AND 1 THEN P=(B+O) AND 511 ELSE P=(A+O) AND 511
100 IF P>255 THEN P=511-P
110 IF I AND 2 THEN Q=(E+W) AND 255 ELSE Q=(D+W) AND 255
120 IF Q>127 THEN Q=255-Q
122 Q=Q+32
125 CS#=CS#+P+Q
130 PUT SPRITE I,(P,Q)
135 O=O+7:W=W+11
140 NEXT I
150 NEXT F
160 EL!=PEEK(&HFC9E)+256!*PEEK(&HFC9F)-T0!
170 IF EL!<0 THEN EL!=EL!+65536!
260 LOCATE 0,22:PRINT "BAS F=";EL!;" C=";CS#
270 FOR I=0 TO 2000:NEXT I:SCREEN 0:PRINT "BAS F=";EL!;" C=";CS#
280 END
