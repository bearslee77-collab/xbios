1 ' LIFE.BAS
20 SCREEN 5:DEFINT A-Z:W=32:H=24:GE=24:CE=767
30 DIM A(CE),B(CE)
40 A(11*W+16)=1:A(11*W+17)=1:A(12*W+15)=1:A(12*W+16)=1:A(13*W+16)=1
50 A(2*W+3)=1:A(3*W+4)=1:A(4*W+2)=1:A(4*W+3)=1:A(4*W+4)=1
60 FOR K=0 TO CE:IF A(K)=1 THEN LINE((K MOD W)*8,(K\W)*8)-((K MOD W)*8+7,(K\W)*8+7),15,BF
70 NEXT K
80 TC!=0:CS=0
90 FOR G=0 TO GE-1
100 T0!=PEEK(&HFC9E)+256!*PEEK(&HFC9F)
110 FOR YY=0 TO H-1
120 UP=YY-1:IF UP<0 THEN UP=H-1
130 DN=YY+1:IF DN=H THEN DN=0
140 RO=YY*W:UO=UP*W:WO=DN*W
150 FOR XX=0 TO W-1
160 LF=XX-1:IF LF<0 THEN LF=W-1
170 RT=XX+1:IF RT=W THEN RT=0
180 N=A(UO+LF)+A(UO+XX)+A(UO+RT)+A(RO+LF)+A(RO+RT)+A(WO+LF)+A(WO+XX)+A(WO+RT)
190 V=0:IF N=3 THEN V=1
200 IF N=2 AND A(RO+XX)=1 THEN V=1
210 B(RO+XX)=V
220 NEXT XX
230 NEXT YY
240 D!=PEEK(&HFC9E)+256!*PEEK(&HFC9F)-T0!:IF D!<0 THEN D!=D!+65536!
250 TC!=TC!+D!
260 FOR K=0 TO CE
270 IF B(K)=A(K) THEN 300
280 C=1:IF B(K)=1 THEN C=15
290 LINE((K MOD W)*8,(K\W)*8)-((K MOD W)*8+7,(K\W)*8+7),C,BF
300 NEXT K
310 T0!=PEEK(&HFC9E)+256!*PEEK(&HFC9F)
320 LV=0:FOR K=0 TO CE:A(K)=B(K):LV=LV+B(K):NEXT K
330 D!=PEEK(&HFC9E)+256!*PEEK(&HFC9F)-T0!:IF D!<0 THEN D!=D!+65536!
340 TC!=TC!+D!
350 CS=CS+(G+1)*LV
360 NEXT G
370 LOCATE 0,22:PRINT "BAS F=";TC!;" C=";CS
375 FOR I=0 TO 2000:NEXT I:SCREEN 0:PRINT "BAS F=";TC!;" C=";CS
380 END
