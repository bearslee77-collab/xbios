1 ' MANDEL.BAS
20 SCREEN 5:W=128:H=191:IT=8:MI=95
30 X0=-8806:Y0=-5130:DX=96:DY=54:F4=16384
40 CS=0:T0=PEEK(&HFC9E)+256*PEEK(&HFC9F)
50 FOR PY=0 TO MI
60 CY=Y0+PY*DY:MR=H-1-PY
70 FOR PX=0 TO W-1
80 CX=X0+PX*DX
90 ZX=0:ZY=0:I=0
100 X2=INT(ZX*ZX/4096):Y2=INT(ZY*ZY/4096)
110 IF X2+Y2>F4 THEN 140
120 ZY=INT(ZX*ZY/2048)+CY:ZX=X2-Y2+CX
130 I=I+1:IF I<IT THEN 100
140 CS=CS+I:C=I+1:X=PX+PX
150 LINE(X,PY)-(X+1,PY),C
160 LINE(X,MR)-(X+1,MR),C
170 NEXT PX
180 NEXT PY
190 EL=PEEK(&HFC9E)+256*PEEK(&HFC9F)-T0
200 IF EL<0 THEN EL=EL+65536
210 LINE(0,0)-(255,7),0,BF:PSET(0,0):PRINT"BAS F=";EL;" C=";CS
220 FOR I=0 TO 2000:NEXT I:SCREEN 0:PRINT "BAS F=";EL;" C=";CS
230 END
