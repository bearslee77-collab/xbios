1 ' XCLAIM.BAS
10 DEFINT A-Z:DEFSNG C,G,T
20 COLOR 15,1,1:SCREEN 5,0
30 SPRITE$(1)=CHR$(112)+CHR$(248)+CHR$(248)+CHR$(248)+CHR$(112)+CHR$(0)+CHR$(0)+CHR$(0)
40 U=4:K=12:W=8:N=4
50 LINE (0,0)-(255,191),K,BF
60 LINE (4,4)-(251,187),U,BF
70 LINE (0,192)-(255,211),1,BF
80 DIM X(5),Y(5),DX(5),DY(5)
90 FOR I=0 TO 4
100 X(I)=40+I*40:Y(I)=40+I*24:DX(I)=2:DY(I)=2
110 IF I MOD 2=1 THEN DX(I)=-2
120 NEXT
130 FOR I=0 TO N-1:PUT SPRITE I+1,(X(I),Y(I)),10,1:NEXT
140 C=0:T=TIME
150 FOR F=1 TO 60
160 FOR I=0 TO N-1
170 A=X(I)+DX(I):B=Y(I)+DY(I)
180 P=POINT(A,B)
190 IF P=W THEN 300
200 IF P=U THEN X(I)=A:Y(I)=B:PUT SPRITE I+1,(A,B):GOTO 230
210 IF POINT(A,Y(I))<>U THEN DX(I)=-DX(I)
220 IF POINT(X(I),B)<>U THEN DY(I)=-DY(I)
230 NEXT
240 FOR I=0 TO N-1:C=C+X(I)+Y(I):NEXT
250 NEXT
260 G=TIME-T:IF G<0 THEN G=G+65536
270 SCREEN 0
280 PRINT "BAS N=";N;"F=";G;"C=";C
290 GOTO 290
300 PRINT "HIT":GOTO 300
