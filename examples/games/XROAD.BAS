1 ' XROAD.BAS
20 DEFINT A-Z:DEFSNG C,G,T
30 COLOR 15,14,2:SCREEN 2,1
50 LINE(24,0)-(27,191),15,BF
60 LINE(228,0)-(231,191),15,BF
70 FOR I=0 TO 5:V=I*32:LINE(60,V)-(63,V+15),15,BF:LINE(164,V)-(167,V+15),15,BF:NEXT
80 SPRITE$(0)=CHR$(24)+CHR$(60)+CHR$(60)+CHR$(126)+CHR$(126)+CHR$(90)+CHR$(126)+CHR$(102)
90 SPRITE$(1)=CHR$(102)+CHR$(126)+CHR$(90)+CHR$(126)+CHR$(126)+CHR$(60)+CHR$(60)+CHR$(24)
100 N=12:DIM Y(13)
150 FOR I=0 TO N-1
160 IF I=0 THEN Y(I)=INT(RND(-1)*121) ELSE Y(I)=INT(RND(1)*121)
170 PUT SPRITE I+1,(I*16+8,Y(I)),10,1
180 NEXT
190 FOR I=N TO 13:PUT SPRITE I+1,(0,209),0,0:NEXT
200 PUT SPRITE 0,(0,209),0,0
210 C=0:T=TIME
220 FOR F=1 TO 60
230 FOR I=0 TO N-1
240 B=Y(I)+6
250 IF B>184 THEN B=0
260 Y(I)=B
270 C=C+B
280 PUT SPRITE I+1,(I*16+8,B)
290 NEXT
300 NEXT
310 G=TIME-T:IF G<0 THEN G=G+65536
320 SCREEN 0
330 PRINT "BAS N=";N;"F=";G;"C=";C
340 GOTO 340
